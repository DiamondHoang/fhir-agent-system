# Neo4j — FHIR graph
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
FHIR_SERVER_URL=http://172.16.12.230:8012/fhir

# LLM provider switch: "ollama" (local) or "company" (internal API)
LLM_PROVIDER=ollama

# Company internal OpenAI-compatible API (used when LLM_PROVIDER=company)
COMPANY_LLM_BASE_URL=https://internal-api.example.com/v1
COMPANY_LLM_API_KEY=
COMPANY_LLM_MODEL=your-chat-model
COMPANY_EMBEDDING_BASE_URL=https://internal-api.example.com/v1
COMPANY_EMBEDDING_API_KEY=
COMPANY_EMBEDDING_MODEL=your-embedding-model
COMPANY_EMBEDDING_DIMS=768

# Local Ollama (used when LLM_PROVIDER=ollama). Use host.docker.internal
# instead of localhost since the backend runs inside Docker.
OLLAMA_LLM_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_LLM_API_KEY=ollama
OLLAMA_LLM_MODEL=your-ollama-chat-model
OLLAMA_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_EMBEDDING_API_KEY=ollama
OLLAMA_EMBEDDING_MODEL=your-ollama-embedding-model
OLLAMA_EMBEDDING_DIMS=1024

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fhir_agent

# Mem0
MEM0_AGENT_ID=fhir-clinical-agent
MEM0_VECTOR_STORE_PROVIDER=pgvector
MEM0_COLLECTION_NAME=fhir_agent_memories

# Short-term conversational memory
SHORT_TERM_ENABLED=true
SHORT_TERM_MAX_TOKENS=12000
SHORT_TERM_RECENT_TOKENS=6000
SHORT_TERM_SUMMARY_MAX_TOKENS=2000
SHORT_TERM_COMPACTION_THRESHOLD=0.75
SHORT_TERM_CHARS_PER_TOKEN=4.0

# JWT authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application
DOMAIN_ID=healthcare
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Skin diagnostic workflow
# Leave model/base URL empty to reuse INTERNAL_LLM_* settings.
SKIN_VISION_BASE_URL=
SKIN_VISION_MODEL=
SKIN_REASONING_BASE_URL=
SKIN_REASONING_MODEL=
SKIN_EMBEDDING_BASE_URL=
SKIN_EMBEDDING_API_KEY=
SKIN_EMBEDDING_MODEL=
SKIN_LLM_MAX_TOKENS=4096
SKIN_KB_ENABLED=true
SKIN_QDRANT_URL=http://localhost:6333
SKIN_QDRANT_COLLECTION=disease_symptoms
SKIN_KB_MIN_SCORE=0.6
SKIN_SESSION_TTL_HOURS=24
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Upstream skin-diagnostic-system variable names.
# These are used by the vendored upstream pipeline/config modules.
# Also follow LLM_PROVIDER above.
COMPANY_VISION_URL=http://172.16.12.230:8000
COMPANY_VISION_MODEL=gemma-4-26B-A4B-it
COMPANY_VISION_PREFER=gemma-4
COMPANY_REASONING_URL=http://172.16.12.230:8000
COMPANY_REASONING_MODEL=gemma-4-26B-A4B-it
COMPANY_REASONING_PREFER=gemma-4
COMPANY_KB_EMBEDDING_URL=http://172.16.12.230:8004
COMPANY_KB_EMBEDDING_MODEL=BAAI/bge-m3

OLLAMA_VISION_URL=http://host.docker.internal:11434
OLLAMA_VISION_MODEL=your-ollama-vision-model
OLLAMA_VISION_PREFER=gemma4
OLLAMA_REASONING_URL=http://host.docker.internal:11434
OLLAMA_REASONING_MODEL=your-ollama-reasoning-model
OLLAMA_REASONING_PREFER=gemma4
OLLAMA_KB_EMBEDDING_URL=http://host.docker.internal:11434
OLLAMA_KB_EMBEDDING_MODEL=your-ollama-embedding-model

VISION_MODEL_TIMEOUT=600
REASONING_MODEL_TIMEOUT=1200
EMBEDDING_TIMEOUT=120
QDRANT_MODE=server
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=disease_symptoms
